# Session signing (required)
AUTH_SECRET=replace-with-a-long-random-string

# Postgres (Plan A: Supabase URI, Plan B: Railway Postgres)
DATABASE_URL=

# Real auth — Supabase path (Plan A / C). Leave blank if using Better Auth on DATABASE_URL.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Twilio (trial works with verified numbers only)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

APP_ENV=demo
AUTH_SECRET=dev-only-referlink-secret-change-me-32-chars
APP_URL=http://localhost:4000
# Railway: set DATABASE_URL using a reference to your PostgreSQL service. Do not commit its value.
# SEED_DEMO_DATA=true with APP_ENV=demo enables synthetic seed accounts on an empty hosted database.

# Real email (required for password reset / invites outside Demo inbox). Prefer Resend OR SMTP.
# EMAIL_FROM="ReferLinkMD <noreply@yourdomain.com>"
# SUPPORT_EMAIL=support@ReferlinkMD.com
# RESEND_API_KEY=re_xxxxxxxx
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# Session signing / Better Auth secret (required)
AUTH_SECRET=replace-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# SQLite file for local phase 2. Leave empty to use data/referlinkmd.db.
# Hosted Postgres (Railway / Supabase) is the next swap — not in this slice.
DATABASE_URL=file:./data/referlinkmd.db

# Specialists are free until adoption. Set true to enforce the 3-month
# trial then $49/month paywall. Trial dates are still written on signup.
SPECIALIST_BILLING_ENABLED=false

# Real auth — Supabase path (Plan A / C). Leave blank; this slice uses Better Auth.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Twilio (trial works with verified numbers only)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

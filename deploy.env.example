# Copy to .env on the server (do not commit the real .env).
# docker compose -f docker-compose.prod.yml --env-file .env up -d --build

POSTGRES_PASSWORD=change-me-to-a-long-random-password
AUTH_SECRET=change-me-to-at-least-32-random-characters
APP_URL=http://YOUR_STATIC_IP_OR_DOMAIN

# demo | production
APP_ENV=demo
# Seed Harbor/Riverside demo accounts on an empty database
SEED_DEMO_DATA=true

# Real email for password reset and invites (Resend OR SMTP)
# EMAIL_FROM="ReferLinkMD <noreply@yourdomain.com>"
# SUPPORT_EMAIL=support@ReferlinkMD.com
# RESEND_API_KEY=re_xxxxxxxx
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
